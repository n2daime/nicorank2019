<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- zip 同梱で配布される初回起動時は MOTW 付きであり得る。マネージ読取は自 exe のみだが、
       念のため本体（nicorank2019.exe.config）と同一の解除を付ける。lib/ 依存は持たない。 -->
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
